{
  "$schema": "https://schema.railpack.com",
  // Cliente de PostgreSQL en la imagen final, para backup/restore desde el panel.
  //
  // El Postgres de Railway es la version 18 y el `postgresql-client` de Debian es 17:
  // pg_dump/psql abortan con "server version mismatch". Por eso en vez del paquete apt
  // copiamos los binarios 18 de la imagen oficial de PostgreSQL.
  //
  // `...` mantiene las capas que genera Railpack (base + build) y agrega esta.
  "deploy": {
    "aptPackages": ["postgresql-client"],
    "inputs": [
      "...",
      {
        "image": "postgres:18",
        "include": [
          "/usr/lib/postgresql/18/bin",
          "/usr/lib/postgresql/18/lib",
          "/usr/lib/x86_64-linux-gnu/libpq.so.5"
        ]
      }
    ]
  }
}
